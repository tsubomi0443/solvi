[misc]
  # 終了時に一時ファイルを削除
  clean_on_exit = true

[build]
  # 起動前にTailwindをビルド + vendorコピー
  pre_cmd = ["bun run --cwd frontend build"]
  include_dir = []
  include_ext = ["go", "tpl", "tmpl", "html", "js", "ts", "css"]
  include_file = ["frontend/package.json", "./.env", "./.air.toml", "./cmd/app/main.go", "templates/**/*.html", "static/js/app/**", "frontend/tailwind.config.js"]
  exclude_dir = ["frontend/node_modules", "static/vendor"]
  exclude_file = ["static/css/output.css"]
  cmd = "go build -o ./tmp/main ./cmd/app"
  kill_delay = 1000

[color]
  app = ""
  build = "yellow"
  main = "magenta"
  runner = "green"
  watcher = "cyan"
